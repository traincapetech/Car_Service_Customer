# ====================================================================
# Hostinger Apache Configuration for Next.js Frontend
# Addior Mechanics / Car Service Platform
# ====================================================================

# 1. CHARACTER ENCODING & MIME TYPES
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType application/json .json
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType image/webp .webp
    AddType image/avif .avif
</IfModule>

# 2. DISABLE DIRECTORY BROWSING & PROTECT SENSITIVE FILES
Options -Indexes

<FilesMatch "^\.(env|git|htaccess|htpasswd|DS_Store)">
    Require all denied
</FilesMatch>

<FilesMatch "(package\.json|package-lock\.json|next\.config\.(js|mjs)|README\.md)">
    Require all denied
</FilesMatch>

# 3. SECURITY HEADERS
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# 4. GZIP / DEFLATE COMPRESSION
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 5. BROWSER CACHING (EXPIRES & CACHE-CONTROL)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML files: Do not cache to ensure latest deployments load immediately
    ExpiresByType text/html "access plus 0 seconds"

    # Static assets (Next.js hashed chunks, images, fonts)
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Static build chunks under _next/static are content-hashed and immutable
    <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML documents: must revalidate with server
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# 6. URL REWRITES & ROUTING
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # A. Enforce HTTPS
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # B. Remove trailing slashes (except root directory)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # ------------------------------------------------------------------
    # C1. HOSTINGER NODE.JS REVERSE PROXY (If running Next.js Node server)
    # If your Hostinger plan has Node.js Application Manager active,
    # uncomment the lines below and set your assigned PORT (default 3000):
    # ------------------------------------------------------------------
    # RewriteCond %{REQUEST_URI} !^/\.well-known
    # RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
    # ProxyPassReverse / http://127.0.0.1:3000/

    # ------------------------------------------------------------------
    # C2. STATIC EXPORT / CLEAN ROUTING (Hostinger Standard Web Hosting)
    # ------------------------------------------------------------------
    # 1) If the requested file or directory exists, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2) Check if a matching .html file exists (e.g., /admin/reports -> /admin/reports.html)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # 3) Check if a matching subfolder index.html exists (e.g., /admin/reports -> /admin/reports/index.html)
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    # 4) Fallback to root index.html for Single Page Application / dynamic routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^ index.html [L]

    # Fallback to 404.html if present
    ErrorDocument 404 /404.html
</IfModule>
